# One image for every Python service; the compose `command` selects which app runs.
# Keeping a single image means the invariant lint and the dependency set are identical
# everywhere, and a service cannot quietly acquire a model client of its own.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

WORKDIR /app

# Dependency layer: copy only the manifests so the resolved environment caches across
# source edits. Every workspace member is listed; `tests/test_container_build.py` fails if a
# new one is added and forgotten, because the symptom otherwise is a stale dependency layer
# rather than an error.
COPY pyproject.toml uv.lock ./
COPY libs/common/pyproject.toml libs/common/
COPY libs/schemas/pyproject.toml libs/schemas/
COPY libs/authz/pyproject.toml libs/authz/
COPY libs/ports/pyproject.toml libs/ports/
COPY libs/vntext/pyproject.toml libs/vntext/
COPY libs/clients/pyproject.toml libs/clients/
COPY services/registry/pyproject.toml services/registry/
COPY services/idp/pyproject.toml services/idp/
COPY services/pii-gate/pyproject.toml services/pii-gate/
COPY services/identity-merge/pyproject.toml services/identity-merge/
COPY services/indexer/pyproject.toml services/indexer/
COPY services/retrieval-api/pyproject.toml services/retrieval-api/
COPY services/chat-api/pyproject.toml services/chat-api/
COPY services/portal-api/pyproject.toml services/portal-api/
COPY services/workflows/pyproject.toml services/workflows/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen --no-install-workspace --no-dev

COPY libs/ libs/
COPY services/ services/
COPY ops/alembic/ ops/alembic/
COPY alembic.ini ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen --no-dev

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin kb \
    && chown -R kb:kb /app
USER kb

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

CMD ["uvicorn", "kb_registry.main:app", "--host", "0.0.0.0", "--port", "8000"]
