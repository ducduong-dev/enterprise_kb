# Copy to .env for local development. Never commit a real .env.
KB_ENV=dev
# What this deployment serves: `internal` (the platform) or `dmz` (the public surface). A
# `dmz` process refuses the internal chat surface however it is reached (INV-4, ADR-0022).
KB_SURFACE=internal
KB_LOG_LEVEL=INFO
KB_LOG_FORMAT=console

KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=kb
KB_DB_USER=kb
KB_DB_PASSWORD=kb

KB_S3_ENDPOINT=http://localhost:9000
KB_S3_ACCESS_KEY=minioadmin
KB_S3_SECRET_KEY=minioadmin

# Resolved in M7 (ADR-0021): pg_search in production. `postgres_fts` is the fallback for a
# Postgres without the extension — it is not BM25 and says so in its adapter info.
KB_KEYWORD_BACKEND=pg_search

# Where a *browser* reaches this deployment. The portal serves the bundle, proxies the API at
# /api and Keycloak at /realms, so this one origin is the whole stack's front door — one
# forwarded port is enough. Change it (and rebuild the portal) if you browse from another
# machine: the OIDC issuer is stamped from it, and a token minted for one origin does not
# verify against another.
KB_PUBLIC_ORIGIN=http://localhost:5173

KB_OIDC_ISSUER=http://localhost:5173/realms/kb
KB_OIDC_AUDIENCE=kb-platform
# Dev/test only. get_settings() refuses to honour this outside dev/test.
KB_OIDC_ALLOW_INSECURE_TOKENS=false

# Every model call — generation, vision, embedding, rerank — goes through the LiteLLM proxy
# (ADR-0024). The services know roles; ops/litellm/config.yaml knows providers.
# No model node on this machine? Set this and the embedding/rerank/generation ports
# become the deterministic local adapters, which declare `semantic: false` /
# `real_model: false`. Storage, auth and the database stay real. Refused outside
# dev/test.
KB_MODEL_DETERMINISTIC_FALLBACK=false

KB_MODEL_USE_PROXY=true
KB_MODEL_PROXY_URL=http://localhost:4000
KB_MODEL_PROXY_API_KEY=sk-kb-dev
LITELLM_MASTER_KEY=sk-kb-dev

# Model aliases as defined in ops/litellm/config.yaml.
KB_MODEL_GENERATION_MODEL=kb-generation
KB_MODEL_VLM_MODEL=kb-vlm
KB_MODEL_EMBEDDING_MODEL=kb-embedding
KB_MODEL_RERANK_MODEL=kb-rerank

# Aliases above whose route leaves the bank's network, and the Compliance switch that permits
# them at all ([OPEN]-1). Both must be set for a public model to be usable; the platform
# refuses the route otherwise, at start-up rather than on the first document.
KB_MODEL_EXTERNAL_MODELS=[]
KB_MODEL_ALLOW_EXTERNAL_PROCESSING=false

# How scanned pages are read (ADR-0025):
#   paddle  OCR every page, escalate the unreadable ones to the vision model
#   vlm     transcribe every page with the vision model — better on degraded scans, far more
#           expensive, and with a public model it sends the page image outside the bank
KB_MODEL_OCR_ENGINE=paddle
KB_MODEL_OCR_LANG=vi

# The weights each model server loads. Distinct from the aliases above: those are what the
# platform asks the proxy for, these are what the proxy's upstreams actually run.
VLLM_GENERATION_MODEL=Qwen/Qwen2.5-32B-Instruct
VLLM_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
TEI_EMBEDDING_MODEL=BAAI/bge-m3
TEI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Direct endpoints, used only when KB_MODEL_USE_PROXY=false.
KB_MODEL_GENERATION_BACKEND=vllm
KB_MODEL_GENERATION_URL=http://localhost:8084
KB_MODEL_EMBEDDING_URL=http://localhost:8081
KB_MODEL_RERANK_URL=http://localhost:8082
KB_MODEL_VLM_URL=http://localhost:8083

KB_TEMPORAL_HOST=localhost:7233
KB_TEMPORAL_NAMESPACE=default

# Where the retrieval funnel lives for this deployment (INV-1). The DMZ points at its own
# instance; nothing else may query an index directly.
KB_RETRIEVAL_URL=http://localhost:8006

# The DMZ's database role (ops/dmz/external-role.sql). Only the public profile uses it.
KB_DMZ_DB_PASSWORD=dmz-dev-password

KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
GRAFANA_PASSWORD=admin
